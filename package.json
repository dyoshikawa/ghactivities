{
	"name": "ghactivities",
	"version": "1.3.0",
	"description": "",
	"keywords": [
		"ai",
		"rules",
		"cli",
		"copilot",
		"cursor",
		"cline",
		"configuration",
		"development"
	],
	"homepage": "https://github.com/dyoshikawa/ghactivities#readme",
	"bugs": {
		"url": "https://github.com/dyoshikawa/ghactivities/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/dyoshikawa/ghactivities.git"
	},
	"license": "MIT",
	"author": "dyoshikawa",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"ghactivities": "dist/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vp pack",
		"check": "vp check --deny-warnings && pnpm run typecheck",
		"cicheck": "pnpm run cicheck:code && pnpm run cicheck:content",
		"cicheck:code": "pnpm run check && pnpm run test",
		"cicheck:content": "pnpm run cspell && pnpm run secretlint",
		"cspell": "cspell --no-progress --gitignore .",
		"dev": "tsx src/cli/index.ts",
		"fix": "vp check --fix",
		"fmt": "vp fmt",
		"fmt:check": "vp fmt --check",
		"generate": "rulesync generate",
		"knip": "knip",
		"oxlint": "vp lint --max-warnings 0",
		"oxlint:fix": "vp lint --fix --max-warnings 0",
		"prepublishOnly": "pnpm run build",
		"secretlint": "secretlint --secretlintignore .gitignore \"**/*\"",
		"sort": "sort-package-json",
		"test": "vp test run --silent",
		"test:coverage": "vp test run --coverage --silent",
		"test:e2e": "vp test run --config vitest.e2e.config.ts --silent=false",
		"test:watch": "vp test --silent",
		"typecheck": "tsgo --noEmit",
		"prepare": "vp config --no-agent && pnpm generate"
	},
	"dependencies": {
		"@ai-sdk/google": "4.0.10",
		"@ai-sdk/google-vertex": "5.0.13",
		"@ai-sdk/openai": "4.0.9",
		"@clack/prompts": "1.0.0",
		"@octokit/graphql": "9.0.3",
		"@openrouter/ai-sdk-provider": "3.0.0",
		"ai": "7.0.18",
		"js-tiktoken": "^1.0.21",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@secretlint/secretlint-rule-preset-recommend": "11.3.1",
		"@tsconfig/node24": "24.0.4",
		"@types/node": "25.2.2",
		"@typescript/native-preview": "7.0.0-dev.20260208.1",
		"@vitest/coverage-v8": "catalog:",
		"cspell": "9.6.4",
		"knip": "6.25.0",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"rulesync": "37.1.0",
		"secretlint": "11.3.1",
		"sort-package-json": "3.6.1",
		"tsx": "4.23.15",
		"typescript": "5.9.3",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
